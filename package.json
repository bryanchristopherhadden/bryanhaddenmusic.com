{
  "name": "@bryan-hadden/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bryan-hadden/main",
    "build": "npm run build --workspace=@bryan-hadden/main",
    "start": "npm run start --workspace=@bryan-hadden/main",
    "lint": "npm run lint --workspace=@bryan-hadden/main"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.2",
    "@types/react": "^18.2.24",
    "@types/styled-components": "^5.1.34",
    "eslint": "^9.0.0",
    "typescript": "^5.2.2"
  }
}